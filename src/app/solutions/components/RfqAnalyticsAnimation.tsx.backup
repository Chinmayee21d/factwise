'use client';

import React, { useState, useEffect, useRef } from 'react';

/* ============ TYPES ============ */
interface RfqAnalyticsAnimationProps {
  speed?: number;
  isAuto?: boolean;
  controlledPhase?: number | null;
  activeMenuStep?: number | null; // explicitly selected menu item (1-5), null = auto-derived
  onPhaseChange?: (phase: number) => void;
  onToggleAuto?: () => void;
}

interface BidDetail {
  q: number; // raw quote price
  d: number; // duty cost
  f: number; // freight cost
  i: number; // insurance cost
}

interface Bidder {
  fx: string;
  flag: string;
  name: string;
  L1: BidDetail;
  L2: BidDetail;
  [key: string]: string | BidDetail;
}

interface SvgProps {
  s?: number;
}

/* ============ ICONS ============ */
const RAI = {
  BarChart: ({ s }: SvgProps) => (
    <svg viewBox="0 0 24 24" width={s || 12} height={s || 12} fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
      <line x1="18" y1="20" x2="18" y2="10" />
      <line x1="12" y1="20" x2="12" y2="4" />
      <line x1="6" y1="20" x2="6" y2="14" />
    </svg>
  ),
  Calculator: ({ s }: SvgProps) => (
    <svg viewBox="0 0 24 24" width={s || 12} height={s || 12} fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
      <rect x="4" y="2" width="16" height="20" rx="2" />
      <line x1="8" y1="6" x2="16" y2="6" />
      <line x1="8" y1="18" x2="16" y2="18" />
    </svg>
  ),
  Refresh: ({ s }: SvgProps) => (
    <svg viewBox="0 0 24 24" width={s || 11} height={s || 11} fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
      <polyline points="23 4 23 10 17 10" />
      <polyline points="1 20 1 14 7 14" />
      <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10" />
      <path d="M20.49 15a9 9 0 0 1-14.85 3.36L1 14" />
    </svg>
  ),
  Trophy: ({ s }: SvgProps) => (
    <svg viewBox="0 0 24 24" width={s || 11} height={s || 11} fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
      <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" />
      <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" />
      <path d="M4 22h16" />
      <path d="M10 14.66V17c0 .55-.45 1-1 1H4v2h16v-2h-5c-.55 0-1-.45-1-1v-2.34" />
      <path d="M12 2a4 4 0 0 1 4 4v7H8V6a4 4 0 0 1 4-4z" />
    </svg>
  ),
  Check: ({ s }: SvgProps) => (
    <svg viewBox="0 0 24 24" width={s || 10} height={s || 10} fill="none" stroke="currentColor" strokeWidth="3.5" strokeLinecap="round" strokeLinejoin="round">
      <polyline points="20 6 9 17 4 12" />
    </svg>
  ),
  Play: ({ s }: SvgProps) => (
    <svg viewBox="0 0 24 24" width={s || 12} height={s || 12} fill="currentColor">
      <polygon points="5 3 19 12 5 21 5 3" />
    </svg>
  ),
  Pause: ({ s }: SvgProps) => (
    <svg viewBox="0 0 24 24" width={s || 12} height={s || 12} fill="currentColor">
      <rect x="6" y="4" width="4" height="16" />
      <rect x="14" y="4" width="4" height="16" />
    </svg>
  ),
};

/* ============ DATA ============ */
const RA_LI = [
  { id: 'L1' as const, name: 'Pump Body', qty: 200 },
  { id: 'L2' as const, name: 'Stator Winding', qty: 200 },
];

const RA_BIDS: Record<string, Bidder> = {
  A: {
    fx: 'INR', flag: 'IN', name: 'Sahasra (Mumbai)',
    L1: { q: 1240, d: 0, f: 60, i: 18 },
    L2: { q: 920, d: 0, f: 45, i: 14 },
  },
  B: {
    fx: 'USD', flag: 'CN', name: 'Pearl River Mfg',
    L1: { q: 1180, d: 142, f: 185, i: 42 },
    L2: { q: 880, d: 106, f: 140, i: 34 },
  },
  C: {
    fx: 'EUR', flag: 'DE', name: 'EuroDrive GmbH',
    L1: { q: 1290, d: 64, f: 120, i: 28 },
    L2: { q: 960, d: 48, f: 95, i: 22 },
  },
};

const RA_KEYS = ['A', 'B', 'C'];

const raSumQuote = (k: string) => RA_LI.reduce((s, li) => {
  const bid = RA_BIDS[k][li.id] as BidDetail;
  return s + bid.q;
}, 0);

const raInr = (n: number) => '₹' + n.toLocaleString('en-IN');

/* ============ STYLE (prefix `ra-`) ============ */
const RA_STYLE = `
.ra-body {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  margin-top: 12px;
  padding-bottom: 80px;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.ra-body::-webkit-scrollbar { display: none; }

/* Breadcrumb */
.ra-crumb { display: flex; align-items: center; gap: 5px; flex-wrap: wrap;
  font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 9.5px; color: #94a3b8;
  animation: ra-fadeIn .35s ease both; }
.ra-tok { padding: 2px 7px; border-radius: 5px; font-weight: 700; border: 1px solid transparent;
  background: #f8fafc; color: #cbd5e1; transition: all .3s ease; letter-spacing: 0.02em; }
.ra-tok.on.slate  { background: #f1f5f9; color: #334155; border-color: #cbd5e1; }
.ra-tok.on.amber  { background: #fef6e7; color: #b45309; border-color: #fde3ad; }
.ra-tok.on.violet { background: #f3f0ff; color: #6d28d9; border-color: #ddd5ff; }
.ra-tok.on.cyan   { background: #ecfeff; color: #0e7490; border-color: #a5f3fc; }
.ra-crumb .plus { color: #cbd5e1; font-weight: 700; }
.ra-crumb .norm { margin-left: 4px; font-size: 9px; color: #94a3b8; font-family: 'Inter', system-ui, sans-serif; font-weight: 500; }

/* Grid */
.ra-grid { background: white; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; position: relative; }

/* Header */
.ra-ghead { display: grid; grid-template-columns: 1.3fr repeat(3, 1fr); background: #f8fafc;
  border-bottom: 1px solid #e2e8f0; }
.ra-ghead > div { padding: 9px 12px; text-align: center; border-left: 1px solid #e2e8f0; }
.ra-ghead > div:first-child { text-align: left; border-left: none; padding-left: 14px; }
.ra-ghead .vCol { display: flex; flex-direction: column; gap: 2px; align-items: center;
  transition: background .35s ease, color .35s ease; }
.ra-ghead .vCol.naive { background: #eff4ff; }
.ra-ghead .vCol.true  { background: #ecfdf5; }
.ra-ghead .vCol.scanning { background: rgba(54,102,255,0.08); }
.ra-ghead .vCol.awarded { background: #ecfdf5; animation: ra-awardedPop .5s cubic-bezier(.34,1.56,.64,1) both; }
.ra-ghead .vCol .vMain { display: flex; align-items: center; gap: 5px;
  font-size: 10px; font-weight: 800; letter-spacing: 0.06em; color: #334155; }
.ra-ghead .vCol.naive .vMain { color: #1e40af; }
.ra-ghead .vCol.true  .vMain { color: #047857; }
.ra-ghead .vCol.awarded .vMain { color: #047857; }
.ra-ghead .vCol .vFlag { width: 15px; height: 15px; border-radius: 3px; background: #e2e8f0; color: #64748b;
  font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 8px;
  display: grid; place-items: center; font-weight: 800; letter-spacing: 0; }
.ra-ghead .vCol .vFx { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 8px;
  letter-spacing: 0.04em; color: #94a3b8; font-weight: 600; text-transform: uppercase; }

/* Data rows */
.ra-grow { display: grid; grid-template-columns: 1.3fr repeat(3, 1fr); border-bottom: 1px solid #f1f5f9; }
.ra-grow.in { animation: ra-rowIn .38s cubic-bezier(.22,1,.36,1) both; }

/* Line item label cell */
.ra-liCell { padding: 10px 14px; display: flex; align-items: center; gap: 9px; text-align: left; }
.ra-liCell .leaf { width: 7px; height: 7px; border-radius: 50%; background: #3666ff; flex-shrink: 0; }
.ra-liCell .liName { font-size: 12px; font-weight: 700; color: #1e293b; line-height: 1.25; letter-spacing: -0.01em; }
.ra-liCell .liQty  { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 8.5px; color: #94a3b8; font-weight: 600; margin-top: 1px; letter-spacing: 0.04em; }

/* Bid cell */
.ra-bid {
  padding: 8px 12px;
  border-left: 1px solid #f1f5f9;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  min-height: 88px;
  transition: background .35s ease;
}
.ra-bid.naive { background: rgba(239,244,255,0.5); }
.ra-bid.true  { background: rgba(236,253,245,0.5); }
.ra-bid.scanning { background: rgba(54,102,255,0.06); }
.ra-bid.awarded { background: rgba(236,253,245,0.8); }

/* Cost lines */
.ra-bid .line { display: inline-flex; align-items: center; gap: 3px;
  font-family: 'JetBrains Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums;
  animation: ra-pop .38s cubic-bezier(.34,1.56,.64,1) both; }
.ra-bid .line.base { font-size: 11.5px; font-weight: 700; color: #334155; letter-spacing: -0.01em; }
.ra-bid .line.duty { font-size: 9px; font-weight: 600; color: #b45309; }
.ra-bid .line.frt  { font-size: 9px; font-weight: 600; color: #6d28d9; }
.ra-bid .line.ins  { font-size: 9px; font-weight: 600; color: #0e7490; }
.ra-bid .line .lbl { opacity: 0.55; font-size: 8.5px; }

/* Total line */
.ra-bid .tot {
  margin-top: auto;
  padding-top: 5px;
  border-top: 1px dashed #e2e8f0;
  font-family: 'JetBrains Mono', ui-monospace, monospace;
  font-weight: 800; font-size: 10.5px;
  color: #1e293b; width: 100%; text-align: right;
  letter-spacing: -0.01em;
}
.ra-bid.naive .tot { color: #1e40af; }
.ra-bid.true  .tot { color: #047857; }

/* Totals row */
.ra-totalRow { display: grid; grid-template-columns: 1.3fr repeat(3, 1fr); background: #f8fafc;
  border-top: 1px solid #e2e8f0; animation: ra-fadeIn .4s ease both; }
.ra-totalRow .lbl { padding: 10px 14px; font-size: 9px; font-weight: 800; letter-spacing: 0.1em;
  text-transform: uppercase; color: #64748b; display: flex; align-items: center; gap: 6px; text-align: left; }
.ra-totalRow .lbl svg { color: #94a3b8; }
.ra-totalCell { padding: 10px 12px; text-align: right; border-left: 1px solid #e2e8f0;
  display: flex; flex-direction: column; align-items: flex-end; justify-content: center;
  transition: background .35s ease; }
.ra-totalCell.naive { background: #dbe5ff; }
.ra-totalCell.true  { background: #bbf2db; }
.ra-totalCell.scanning { background: rgba(54,102,255,0.08); }
.ra-totalCell.awarded { background: #bbf2db; }
.ra-totalCell .v { font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 800;
  font-size: 12.5px; color: #334155; letter-spacing: -0.02em; }
.ra-totalCell.naive .v { color: #1e3a8a; }
.ra-totalCell.true  .v { color: #047857; }
.ra-totalCell.awarded .v { color: #047857; }
.ra-totalCell .winTag { margin-top: 3px; font-size: 7.5px; font-weight: 800; letter-spacing: 0.08em;
  text-transform: uppercase; display: inline-flex; align-items: center; gap: 3px;
  animation: ra-pop .35s cubic-bezier(.34,1.56,.64,1) both; }
.ra-totalCell.naive .winTag { color: #1e40af; }
.ra-totalCell.true  .winTag { color: #047857; }
.ra-totalCell.awarded .winTag { color: #047857; }

/* Variance row â€” appears below totals at phase 7 */
.ra-varianceRow { display: grid; grid-template-columns: 1.3fr repeat(3, 1fr);
  border-top: 1px solid #e2e8f0; animation: ra-fadeIn .5s ease both; }
.ra-varianceRow .vr-lbl { padding: 8px 14px; font-size: 8.5px; font-weight: 800; letter-spacing: 0.1em;
  text-transform: uppercase; color: #94a3b8; display: flex; align-items: center; gap: 5px; }
.ra-varianceCell { padding: 8px 12px; border-left: 1px solid #f1f5f9;
  display: flex; flex-direction: column; align-items: flex-end; gap: 3px; }
.ra-varianceCell .vc-bar-wrap { width: 100%; height: 4px; background: #f1f5f9; border-radius: 99px; overflow: hidden; }
.ra-varianceCell .vc-bar { height: 100%; border-radius: 99px; animation: ra-barGrow .7s cubic-bezier(.22,1,.36,1) both; }
.ra-varianceCell .vc-pct { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 10px; font-weight: 800; }
.ra-varianceCell .vc-tag { font-size: 7.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
  padding: 1px 5px; border-radius: 4px; }
@keyframes ra-barGrow { from { width: 0; } }

/* Scan overlay â€” sweeps across columns during phase 8 scanning */
.ra-scanOverlay {
  position: absolute; top: 0; bottom: 0; width: 33.33%;
  background: rgba(54,102,255,0.07);
  border-left: 2px solid rgba(54,102,255,0.3);
  border-right: 2px solid rgba(54,102,255,0.3);
  pointer-events: none;
  transition: left .55s cubic-bezier(.22,1,.36,1);
}
.ra-scanOverlay::after {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, transparent, #3666ff, transparent);
  animation: ra-scanLine 1.2s ease-in-out infinite;
}
@keyframes ra-scanLine {
  0%   { top: 0; opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

/* Awarded column overlay */
.ra-awardedOverlay {
  position: absolute; top: 0; bottom: 0;
  width: 33.33%; left: 0;
  background: rgba(34,197,94,0.08);
  border: 2px solid #22c55e;
  border-radius: 0;
  pointer-events: none;
  animation: ra-awardedPop .6s cubic-bezier(.34,1.56,.64,1) both;
}
@keyframes ra-awardedPop {
  0%   { opacity: 0; transform: scaleY(0.92); }
  60%  { opacity: 1; transform: scaleY(1.02); }
  100% { opacity: 1; transform: scaleY(1); }
}

/* Awarded badge that floats above the winner column */
.ra-awardedBadge {
  position: absolute;
  top: -14px; left: 0; width: 33.33%;
  display: flex; justify-content: center;
  animation: ra-pop .5s cubic-bezier(.34,1.56,.64,1) .3s both;
  pointer-events: none;
  z-index: 10;
}
.ra-awardedBadge .ab-inner {
  background: #15803d; color: white;
  font-size: 8px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
  padding: 3px 10px; border-radius: 99px;
  box-shadow: 0 4px 12px rgba(21,128,61,0.4);
  display: flex; align-items: center; gap: 5px;
}

/* Recommendation Panel */
.ra-recPanel {
  display: flex; flex-direction: column; gap: 12px;
  animation: ra-fadeIn .5s cubic-bezier(.22,1,.36,1) both;
}
.ra-recHeader {
  display: flex; align-items: center; justify-content: space-between;
}
.ra-recTitle {
  display: flex; align-items: center; gap: 8px;
}
.ra-recTitle .rt-icon {
  width: 28px; height: 28px; border-radius: 8px;
  background: linear-gradient(135deg, #1e1b4b, #3730a3);
  display: grid; place-items: center; color: #a5b4fc; font-size: 13px; flex-shrink: 0;
}
.ra-recTitle .rt-text {
  font-size: 12px; font-weight: 800; color: #1e293b; letter-spacing: -0.01em;
}
.ra-recTitle .rt-sub {
  font-size: 9px; color: #94a3b8; font-weight: 600; margin-top: 1px;
}
.ra-recBadge {
  font-size: 7.5px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
  padding: 3px 8px; border-radius: 99px;
  background: linear-gradient(135deg, #1e1b4b, #3730a3); color: #a5b4fc;
  animation: ra-pop .4s cubic-bezier(.34,1.56,.64,1) .2s both;
}
.ra-splitBar {
  height: 8px; border-radius: 99px; background: #f1f5f9; overflow: hidden; display: flex; gap: 2px;
}
.ra-splitBar .sb-a {
  height: 100%; border-radius: 99px; background: #22c55e;
  width: 0; animation: ra-fillA .9s cubic-bezier(.22,1,.36,1) .3s forwards;
}
.ra-splitBar .sb-b {
  height: 100%; border-radius: 99px; background: #3b82f6;
  width: 0; animation: ra-fillB .9s cubic-bezier(.22,1,.36,1) .5s forwards;
}
@keyframes ra-fillA { to { width: 60%; } }
@keyframes ra-fillB { to { width: 40%; } }
.ra-splitCards { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.ra-splitCard { border-radius: 12px; padding: 12px 14px; text-align: left;
  animation: ra-pop .45s cubic-bezier(.34,1.56,.64,1) both; }
.ra-splitCard.primary { background: #f0fdf4; border: 1.5px solid #86efac; }
.ra-splitCard.hedge   { background: #eff6ff; border: 1.5px solid #93c5fd; }
.ra-splitCard .sc-pct { font-family: 'JetBrains Mono', ui-monospace, monospace;
  font-size: 28px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
.ra-splitCard.primary .sc-pct { color: #15803d; }
.ra-splitCard.hedge   .sc-pct { color: #1d4ed8; }
.ra-splitCard .sc-vendor { font-size: 10px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; margin-top: 6px; }
.ra-splitCard.primary .sc-vendor { color: #15803d; }
.ra-splitCard.hedge   .sc-vendor { color: #1d4ed8; }
.ra-splitCard .sc-amount { font-family: 'JetBrains Mono', ui-monospace, monospace;
  font-size: 11px; font-weight: 700; color: #475569; margin-top: 3px; }
.ra-splitCard .sc-badge { display: inline-block; margin-top: 6px;
  font-size: 7.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
  padding: 2px 7px; border-radius: 99px; }
.ra-splitCard.primary .sc-badge { background: #dcfce7; color: #15803d; }
.ra-splitCard.hedge   .sc-badge { background: #dbeafe; color: #1d4ed8; }
.ra-chips { display: flex; flex-direction: column; gap: 6px; }
.ra-chip { display: flex; align-items: center; gap: 8px; padding: 7px 12px; background: white;
  border: 1px solid #e2e8f0; border-radius: 8px; font-size: 11px; font-weight: 600; color: #475569;
  opacity: 0; transform: translateX(-8px); animation: ra-chipIn .4s ease forwards; }
.ra-chip .cc { color: #22c55e; font-weight: 800; font-size: 12px; }
@keyframes ra-chipIn { to { opacity: 1; transform: translateX(0); } }

/* Narrative card â€” pinned to bottom */
.ra-narrative {
  position: absolute; left: 0; right: 0; bottom: 0;
  display: flex; align-items: flex-start; gap: 11px;
  padding: 11px 15px;
  background: white;
  border: 1px solid rgba(15,23,42,0.08);
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.ra-pulsingDot { width: 6px; height: 6px; border-radius: 50%; background: #3666ff; margin-top: 5px; flex-shrink: 0;
  animation: ra-pulse 1.6s ease-in-out infinite; }
.ra-narrativeText { font-size: 11.5px; font-weight: 600; color: #475569; line-height: 1.55; text-align: left; }

/* Animations */
@keyframes ra-fadeIn   { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
@keyframes ra-rowIn    { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
@keyframes ra-pop      { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
@keyframes ra-pulse    { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.4); } }

export default function RfqAnalyticsAnimation({
  speed = 1,
  isAuto = true,
  controlledPhase = null,
  activeMenuStep = null,
  onPhaseChange,
  onToggleAuto,
}: RfqAnalyticsAnimationProps) {

  // Inject styles once â€” keyed by version so it never flickers on re-render
  useEffect(() => {
    if (typeof document === 'undefined') return;
    const VERSION = 'ra-v5';
    if (document.getElementById(VERSION)) return; // already injected, skip
    // Remove any old version
    ['ra-style', 'ra-v1', 'ra-v2', 'ra-v3', 'ra-v4'].forEach(id => document.getElementById(id)?.remove());
    const s = document.createElement('style');
    s.id = VERSION;
    s.textContent = RA_STYLE;
    document.head.appendChild(s);
  }, []);

  // Internal states for autoplay
  const [localPhase, setLocalPhase] = useState(0);
  const [localPopulated, setLocalPopulated] = useState(0);
  const [localLayers, setLocalLayers] = useState(0);
  const [localShowTrue, setLocalShowTrue] = useState(false);
  const [localWinner, setLocalWinner] = useState<string | null>(null);
  // Scanning animation state for phase 8 auto-recommendation
  const [scanningVendor, setScanningVendor] = useState<string | null>(null);
  // scanCol: which column the scan overlay is on (0=none, 1=V·A, 2=V·B, 3=V·C, 4=awarded)
  const [localScanCol, setLocalScanCol] = useState(0);

  const cancelRef = useRef(false);
  const bodyRef = useRef<HTMLDivElement>(null);

  // Auto-scroll body when phase changes â€” scroll to bottom for phases >= 8, top otherwise
  useEffect(() => {
    if (!bodyRef.current) return;
    if (localPhase >= 8) {
      bodyRef.current.scrollTo({ top: bodyRef.current.scrollHeight, behavior: 'smooth' });
    } else {
      bodyRef.current.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }, [localPhase]);

  // Also handle controlled phase scroll in manual mode
  useEffect(() => {
    if (!bodyRef.current || isAuto) return;
    if ((controlledPhase ?? 0) >= 8) {
      bodyRef.current.scrollTo({ top: bodyRef.current.scrollHeight, behavior: 'smooth' });
    } else {
      bodyRef.current.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }, [controlledPhase, isAuto]);

  // Autoplay Effect Loop
  useEffect(() => {
    if (!isAuto) return;

    cancelRef.current = false;
    const mul = Math.max(0.3, Number(speed) || 1);
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms / mul));

    async function run() {
      while (!cancelRef.current) {
        setLocalPhase(0);
        setLocalPopulated(0);
        setLocalLayers(0);
        setLocalShowTrue(false);
        setLocalWinner(null);
        setLocalScanCol(0);
        onPhaseChange?.(0);
        await sleep(700);

        // 1 rows populate
        if (cancelRef.current) return;
        setLocalPhase(1);
        onPhaseChange?.(1);
        for (let i = 1; i <= RA_LI.length; i++) {
          if (cancelRef.current) return;
          setLocalPopulated(i);
          await sleep(280);
        }
        await sleep(400);

        // 2 naive winner
        if (cancelRef.current) return;
        setLocalPhase(2);
        setLocalWinner('B');
        onPhaseChange?.(2);
        await sleep(1800);

        // 3 formula activates
        if (cancelRef.current) return;
        setLocalPhase(3);
        onPhaseChange?.(3);
        await sleep(700);

        // 4..6 layers
        for (let l = 1; l <= 3; l++) {
          if (cancelRef.current) return;
          setLocalLayers(l);
          setLocalPhase(3 + l);
          onPhaseChange?.(3 + l);
          await sleep(800);
        }

        // 7 true cost (normalize currency)
        if (cancelRef.current) return;
        setLocalShowTrue(true);
        setLocalPhase(7);
        onPhaseChange?.(7);
        await sleep(1400);

        // 8 scanning animation — sweep V·C → V·B → V·A, then award V·A
        if (cancelRef.current) return;
        setLocalPhase(8);
        onPhaseChange?.(8);
        setLocalScanCol(3); // scan V·C
        await sleep(700);
        if (cancelRef.current) return;
        setLocalScanCol(2); // scan V·B
        await sleep(700);
        if (cancelRef.current) return;
        setLocalScanCol(1); // scan V·A
        await sleep(700);
        if (cancelRef.current) return;
        setLocalScanCol(4); // awarded — V·A selected
        setLocalWinner('A');
        await sleep(2000);

        // 9 auto-recommendation
        if (cancelRef.current) return;
        setLocalPhase(9);
        onPhaseChange?.(9);
        await sleep(4000);
        await sleep(600);
      }
    }

    run();

    return () => {
      cancelRef.current = true;
    };
  }, [speed, isAuto]);

  // Sync internal active parameters based on mode (Controlled vs Auto)
  let activePhase = localPhase;
  let activePopulated = localPopulated;
  let activeLayers = localLayers;
  let activeShowTrue = localShowTrue;
  let activeWinner = localWinner;
  let activeScanCol = localScanCol;

  if (!isAuto && controlledPhase !== null) {
    activePhase = controlledPhase;
    activeScanCol = 0;
    // Map manual/controlled phase details
    if (controlledPhase === 0) {
      activePopulated = 0; activeLayers = 0; activeShowTrue = false; activeWinner = null;
    } else if (controlledPhase === 1) {
      activePopulated = 2; activeLayers = 0; activeShowTrue = false; activeWinner = null;
    } else if (controlledPhase === 2) {
      activePopulated = 2; activeLayers = 0; activeShowTrue = false; activeWinner = 'B';
    } else if (controlledPhase === 3) {
      activePopulated = 2; activeLayers = 0; activeShowTrue = false; activeWinner = 'B';
    } else if (controlledPhase === 4) {
      activePopulated = 2; activeLayers = 1; activeShowTrue = false; activeWinner = 'B';
    } else if (controlledPhase === 5) {
      activePopulated = 2; activeLayers = 2; activeShowTrue = false; activeWinner = 'B';
    } else if (controlledPhase === 6) {
      activePopulated = 2; activeLayers = 3; activeShowTrue = false; activeWinner = 'B';
    } else if (controlledPhase === 7) {
      activePopulated = 2; activeLayers = 3; activeShowTrue = true; activeWinner = 'B';
    } else if (controlledPhase === 8) {
      activePopulated = 2; activeLayers = 3; activeShowTrue = true; activeWinner = 'A'; activeScanCol = 4;
    } else if (controlledPhase === 9) {
      activePopulated = 2; activeLayers = 3; activeShowTrue = true; activeWinner = 'A'; activeScanCol = 4;
    }
  }

  const totalAtLayer = (k: string) => {
    let t = raSumQuote(k);
    const bid = RA_BIDS[k];
    if (activeLayers >= 1) t += RA_LI.reduce((s, li) => s + (bid[li.id] as BidDetail).d, 0);
    if (activeLayers >= 2) t += RA_LI.reduce((s, li) => s + (bid[li.id] as BidDetail).f, 0);
    if (activeLayers >= 3) t += RA_LI.reduce((s, li) => s + (bid[li.id] as BidDetail).i, 0);
    return t;
  };

  // Derive the active menu step (1-5) from the current animation phase
  const getActiveMenuStep = (): number => {
    if (!isAuto && activeMenuStep !== null) return activeMenuStep;
    if (activePhase >= 1 && activePhase <= 2) return 1;
    if (activePhase >= 3 && activePhase <= 6) return 2;
    if (activePhase === 7) return 3;
    if (activePhase === 8) return 4;
    if (activePhase === 9) return 5;
    return 0;
  };

  // Narrative text tied to each menu step
  const getNarrativeText = (): string => {
    const step = getActiveMenuStep();
    switch (step) {
      case 1:
        return 'Raw bids arrive from 3 vendors in their native currencies â€” INR, USD, and EUR. At face value, Pearl River (VÂ·B) looks cheapest at â‚¹2,060 per unit. But unit price alone is never the full story.';
      case 2:
        return 'FactWise layers on import duty (HSN-classified), freight corridors, and marine insurance for each foreign bid. VÂ·B picks up â‚¹248 in duty + â‚¹325 in freight. VÂ·C adds â‚¹112 in duty + â‚¹215 in freight. VÂ·A, being domestic, carries zero duty.';
      case 3:
        return 'All bids are normalized to INR using live treasury FX rates. USD and EUR quotes are converted at real-time mid-market rates â€” eliminating the currency illusion that makes foreign bids appear cheaper than they are.';
      case 4:
        return 'With true landed costs visible, the variance is stark. VÂ·B\'s apparent â‚¹2,060 lead becomes â‚¹3,149 landed â€” 52% higher than the raw quote. Sahasra (VÂ·A) at â‚¹2,315 landed is now the clear cost leader across both line items.';
      case 5:
        return 'FactWise auto-generates the award recommendation: split 60/40 between Sahasra and a secondary supplier to de-risk single-source dependency. Compliance scorecards are created instantly for audit and category authority sign-off.';
      default:
        return 'Initiating landed cost computation. Bids will be ingested, layered with logistics costs, normalized to INR, and ranked by true total cost of ownership.';
    }
  };

  return (
    <div className="relative rounded-3xl bg-white border border-slate-200/80 p-3.5 shadow-[0_20px_60px_rgba(0,0,0,0.12)] overflow-hidden flex flex-col justify-between select-none" style={{ height: '692px', minHeight: '692px', maxHeight: '692px' }}>

      {/* Top Chrome Bar */}
      <div className="pb-3 border-b border-slate-100 flex items-center justify-between">
        <div className="flex items-center gap-2 text-left">
          <div className="size-6 rounded-lg bg-gradient-to-br from-purple-700 to-[#3666ff] text-white flex items-center justify-center shadow-[0_4px_10px_rgba(123,104,238,0.3)] shrink-0">
            <RAI.BarChart s={13} />
          </div>
          <div className="flex items-center gap-1.5 min-w-0">
            <span className="text-[12px] font-bold text-slate-800 tracking-tight shrink-0">Analytics Engine</span>
            <span className="text-slate-300 text-[10px]">/</span>
            <span className="text-[11px] font-medium text-slate-500 truncate">RFQ-2026-0871 · Landed Cost</span>
          </div>
        </div>
        <div className="flex items-center gap-2 bg-slate-50 border border-slate-100 px-2.5 py-0.5 rounded-full">
          <span className={'size-1.5 rounded-full ' + (isAuto ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500')} />
          <span className="text-[8.5px] font-mono font-bold text-slate-500 uppercase tracking-wider">
            {isAuto ? 'Auto-Pilot' : 'Manual'}
          </span>
        </div>
      </div>

      {/* Body Content */}
      <div ref={bodyRef} className="ra-body">

        {/* Breadcrumb â€” only show for phases 1-7 */}
        {activePhase < 8 && (
          <div className="h-6 flex items-center">
            {activePhase >= 3 ? (
              <div className="ra-crumb">
                <span>Landed =</span>
                <span className="ra-tok on slate">Quote</span>
                <span className="plus">+</span>
                <span className={'ra-tok ' + (activeLayers >= 1 ? 'on amber' : '')}>Duty</span>
                <span className="plus">+</span>
                <span className={'ra-tok ' + (activeLayers >= 2 ? 'on violet' : '')}>Freight</span>
                <span className="plus">+</span>
                <span className={'ra-tok ' + (activeLayers >= 3 ? 'on cyan' : '')}>Insurance</span>
                <span className="norm">Â· normalized â†’ INR</span>
              </div>
            ) : (
              <div className="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-wider">Baseline Ingestion Matrix</div>
            )}
          </div>
        )}

        {/* Matrix Grid â€” only show for phases 1-7 */}
        {activePhase < 8 && (
          <div className="ra-grid">
            {/* Grid Header */}
            <div className="ra-ghead font-mono">
              <div className="text-left font-sans text-slate-400 pl-3">Line item</div>
              {RA_KEYS.map((k) => {
                let cls = activeWinner === k ? (activeWinner === 'A' ? 'true' : 'naive') : '';
                // Add scanning class during phase 8 scanning animation
                if (activePhase === 8 && activeScanCol > 0 && activeScanCol < 4) {
                  const scanningCol = activeScanCol; // 1=V·A, 2=V·B, 3=V·C
                  if (RA_KEYS.indexOf(k) + 1 === scanningCol) {
                    cls += ' scanning';
                  }
                }
                // Add awarded class when V·A is selected
                if (activePhase === 8 && activeScanCol === 4 && k === 'A') {
                  cls += ' awarded';
                }
                return (
                  <div key={k} className={'vCol ' + cls}>
                    <div className="vMain font-bold">
                      <span className="vFlag font-bold text-[8.5px]">{RA_BIDS[k].flag}</span>
                      <span>V·{k}</span>
                    </div>
                    <span className="vFx text-[8px] font-semibold">{RA_BIDS[k].fx}</span>
                  </div>
                );
              })}
            </div>

            {/* Line Item Rows */}
            {RA_LI.map((li, idx) => {
              const visible = idx < activePopulated;
              if (!visible) return null;
              return (
                <div key={li.id} className="ra-grow in" style={{ animationDelay: (idx * 55) + 'ms' }}>
                  <div className="ra-liCell">
                    <span className="leaf" />
                    <div className="min-w-0">
                      <div className="liName truncate">{li.name}</div>
                      <div className="liQty">{li.qty} EA</div>
                    </div>
                  </div>
                  {RA_KEYS.map((k) => {
                    const c = RA_BIDS[k][li.id] as BidDetail;
                    const isWin = activeWinner === k;
                    let cls = isWin ? (activeWinner === 'A' ? 'true' : 'naive') : '';
                    // Add scanning class during phase 8 scanning animation
                    if (activePhase === 8 && activeScanCol > 0 && activeScanCol < 4) {
                      const scanningCol = activeScanCol; // 1=V·A, 2=V·B, 3=V·C
                      if (RA_KEYS.indexOf(k) + 1 === scanningCol) {
                        cls += ' scanning';
                      }
                    }
                    // Add awarded class when V·A is selected
                    if (activePhase === 8 && activeScanCol === 4 && k === 'A') {
                      cls += ' awarded';
                    }
                    const tot = c.q + (activeLayers >= 1 ? c.d : 0) + (activeLayers >= 2 ? c.f : 0) + (activeLayers >= 3 ? c.i : 0);
                    return (
                      <div key={k} className={'ra-bid ' + cls}>
                        <span className="line base">{raInr(c.q)}</span>
                        {activeLayers >= 1 && c.d > 0 && (
                          <span className="line duty"><span className="lbl">+D </span>{raInr(c.d)}</span>
                        )}
                        {activeLayers >= 2 && (
                          <span className="line frt"><span className="lbl">+F </span>{raInr(c.f)}</span>
                        )}
                        {activeLayers >= 3 && (
                          <span className="line ins"><span className="lbl">+I </span>{raInr(c.i)}</span>
                        )}
                        {activeLayers > 0 && <div className="tot">{raInr(tot)}</div>}
                      </div>
                    );
                  })}
                </div>
              );
            })}

            {/* Totals Row */}
            {activePopulated >= RA_LI.length && (
              <div className="ra-totalRow border-t border-slate-200">
                <div className="lbl text-slate-500 font-bold flex items-center gap-1.5 pl-3">
                  <RAI.Refresh s={11} />
                  <span className="truncate">{activeShowTrue ? 'True landed · qty 200' : 'Quote total · qty 200'}</span>
                </div>
                {RA_KEYS.map((k) => {
                  const isWin = activeWinner === k;
                  let cls = isWin ? (activeWinner === 'A' ? 'true' : 'naive') : '';
                  // Add scanning class during phase 8 scanning animation
                  if (activePhase === 8 && activeScanCol > 0 && activeScanCol < 4) {
                    const scanningCol = activeScanCol; // 1=V·A, 2=V·B, 3=V·C
                    if (RA_KEYS.indexOf(k) + 1 === scanningCol) {
                      cls += ' scanning';
                    }
                  }
                  // Add awarded class when V·A is selected
                  if (activePhase === 8 && activeScanCol === 4 && k === 'A') {
                    cls += ' awarded';
                  }
                  const t = totalAtLayer(k);
                  return (
                    <div key={k} className={'ra-totalCell ' + cls}>
                      <div className="v">{raInr(t * 200)}</div>
                      {isWin && (
                        <div className="winTag flex items-center gap-1 font-extrabold uppercase">
                          {activeWinner === 'A' ? (
                            <>
                              <RAI.Trophy s={9} />
                              <span>True winner</span>
                            </>
                          ) : (
                            <span>Lowest quote</span>
                          )}
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            )}

            {/* Variance Highlighting Row - phase 7 only */}
            {activePopulated >= RA_LI.length && activeShowTrue && activePhase === 7 && (
              <div className="ra-varianceRow">
                <div className="vr-lbl">
                  <RAI.BarChart s={10} />
                  <span>Variance Analysis</span>
                </div>
                {RA_KEYS.map((k) => {
                  const t = totalAtLayer(k);
                  const total = t * 200;
                  // Calculate variance from lowest (V·A = ₹275,640)
                  const lowestTotal = totalAtLayer('A') * 200; // V·A is the true winner
                  const variance = ((total - lowestTotal) / lowestTotal) * 100;
                  const isLowest = k === 'A';
                  
                  return (
                    <div key={k} className="ra-varianceCell">
                      <div className="vc-bar-wrap">
                        <div 
                          className="vc-bar" 
                          style={{ 
                            backgroundColor: isLowest ? '#22c55e' : variance <= 10 ? '#f59e0b' : '#ef4444',
                            width: Math.min(100, Math.max(5, Math.abs(variance) * 2)) + '%',
                            animationDelay: (RA_KEYS.indexOf(k) * 0.15) + 's'
                          }} 
                        />
                      </div>
                      <div className={'vc-pct ' + (isLowest ? 'text-emerald-600' : variance <= 10 ? 'text-amber-600' : 'text-red-600')}>
                        {isLowest ? '0.0%' : '+' + variance.toFixed(1) + '%'}
                      </div>
                      <div className={'vc-tag ' + (isLowest ? 'bg-emerald-100 text-emerald-700' : variance <= 10 ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700')}>
                        {isLowest ? 'OPTIMAL' : variance <= 10 ? 'CLOSE' : 'HIGH'}
                      </div>
                    </div>
                  );
                })}
              </div>
            )}

            {/* Scanning Overlay - phase 8 scanning animation */}
            {activePhase === 8 && activeScanCol > 0 && activeScanCol < 4 && (
              <div 
                className="ra-scanOverlay" 
                style={{ 
                  left: (33.33 + (activeScanCol - 1) * 33.33) + '%' 
                }} 
              />
            )}

            {/* Awarded Overlay - phase 8 when V·A is selected */}
            {activePhase === 8 && activeScanCol === 4 && (
              <>
                <div className="ra-awardedOverlay" style={{ left: '33.33%' }} />
                <div className="ra-awardedBadge" style={{ left: '33.33%' }}>
                  <div className="ab-inner">
                    <RAI.Check s={8} />
                    <span>AWARDED</span>
                  </div>
                </div>
              </>
            )}
          </div>
        )}

        {/* Variance Cards â€” phase 8 only */}
        {activePhase === 8 && (
          <>
            <div className="ra-varianceHeader">
              <span className="vh-label">Variance Analysis Â· True Landed Cost</span>
              <span className="vh-badge">Winner Selected</span>
            </div>
            <div className="ra-awardGrid">
              {RA_KEYS.map((k, idx) => {
                const isWin = k === 'A';
                const bid = RA_BIDS[k];
                const perUnit = RA_LI.reduce((s, li) => {
                  const c = bid[li.id] as BidDetail;
                  return s + c.q + c.d + c.f + c.i;
                }, 0);
                const total = perUnit * 200;
                return (
                  <div
                    key={k}
                    className={'ra-awardCard ' + (isWin ? 'winner' : '')}
                    style={{ animationDelay: (idx * 80) + 'ms' }}
                  >
                    <div className="ac-header">
                      <div className="ac-vendor">
                        <span className="ac-flag">{RA_BIDS[k].flag}</span>
                        <span className="ac-name">VÂ·{k}</span>
                      </div>
                      <span className="ac-badge">{isWin ? 'âœ“ SELECTED' : RA_BIDS[k].fx}</span>
                    </div>
                    <div className="ac-divider" />
                    <div className="ac-label">Total Landed Â· Qty 200</div>
                    <div className="ac-total" style={{ animationDelay: (idx * 80 + 100) + 'ms' }}>
                      {raInr(total)}
                    </div>
                    <div className="ac-perunit">{raInr(perUnit)} / unit</div>
                  </div>
                );
              })}
            </div>
          </>
        )}

        {/* Auto-Recommendation Panel â€” phase 9 only */}
        {activePhase >= 9 && (
          <div className="ra-recPanel">
            <div className="ra-recHeader">
              <div className="ra-recTitle">
                <div className="rt-icon">âœ¦</div>
                <div>
                  <div className="rt-text">FactWise Award Recommendation</div>
                  <div className="rt-sub">Generated from landed cost analysis Â· RFQ-2026-0871</div>
                </div>
              </div>
              <span className="ra-recBadge">AI-Generated</span>
            </div>
            <div className="ra-splitBar">
              <div className="sb-a" />
              <div className="sb-b" />
            </div>
            <div className="ra-splitCards">
              <div className="ra-splitCard primary" style={{ animationDelay: '0.2s' }}>
                <div className="sc-pct">60%</div>
                <div className="sc-vendor">VÂ·A Â· Sahasra</div>
                <div className="sc-amount">â‚¹2,75,640</div>
                <span className="sc-badge">Primary Supplier</span>
              </div>
              <div className="ra-splitCard hedge" style={{ animationDelay: '0.35s' }}>
                <div className="sc-pct">40%</div>
                <div className="sc-vendor">VÂ·B Â· Pearl River</div>
                <div className="sc-amount">â‚¹2,16,720</div>
                <span className="sc-badge">Risk Hedge</span>
              </div>
            </div>
            <div className="ra-chips">
              {[
                { text: 'De-risks single-source supplier dependency', delay: '0s' },
                { text: '24.8% cost saving vs awarding VÂ·B alone', delay: '0.15s' },
                { text: 'Compliance audit trail auto-generated', delay: '0.3s' },
              ].map((chip, i) => (
                <div key={i} className="ra-chip" style={{ animationDelay: chip.delay }}>
                  <span className="cc">âœ“</span>
                  <span>{chip.text}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Narrative card â€” permanently fixed at the bottom inside the container */}
        <div className="ra-narrative">
          <span className="ra-pulsingDot" />
          <span className="ra-narrativeText">{getNarrativeText()}</span>
        </div>
      </div>

      {/* Dynamic Control Footer */}
      <div className="pt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400 mt-2">
        <div className="flex items-center gap-1.5">
          <button
            onClick={() => onToggleAuto?.()}
            className="size-5 rounded-md hover:bg-slate-100 hover:text-slate-800 flex items-center justify-center transition-colors cursor-pointer text-slate-500"
            title={isAuto ? 'Pause Autoplay' : 'Resume Autoplay'}
          >
            {isAuto ? <RAI.Pause s={11} /> : <RAI.Play s={11} />}
          </button>
          <span className="font-medium text-slate-500">
            {isAuto ? 'Autopilot Active (Cycling 15s lifecycle)' : 'Paused (Select phases on the left guide)'}
          </span>
        </div>
        <span className="font-mono text-[9px] uppercase tracking-wider text-[#3666ff] font-bold">
          FactWise Engine
        </span>
      </div>
    </div>
  );
}
